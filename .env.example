GOOGLE_API_KEY=

# LangSmith (optionnel). Le tracing n'est actif que si LANGSMITH_TRACING vaut
# exactement « true » : toute autre valeur, ou l'absence de la variable, le désactive.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_pt_
LANGSMITH_PROJECT=grossiste-mada
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Valeur pour les scripts lancés depuis l'hôte ; docker-compose la surcharge
# avec bolt://neo4j:7687 pour le conteneur app.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Postgres : source unique de vérité. configs.py assemble les URLs vers
# POSTGRES_HOST, et docker-compose injecte DB_RAG_URL / DB_BUSINESS_URL avec
# l'hôte interne `db` pour le conteneur app.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=grossiste_mada
POSTGRES_RAG_DB=grossiste_rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Identifiants de connexion à l'interface web pgAdmin (http://localhost:5050)
PGADMIN_EMAIL=admin@grossiste.mg
PGADMIN_PASSWORD=
